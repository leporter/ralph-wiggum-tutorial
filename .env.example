# Database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Flask configuration
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Vite dev server URL (used by Flask templates in development)
VITE_DEV_SERVER=http://localhost:5173

# Optional GitHub personal access token. NOT required: the /learn codebase
# analyzer works against public repositories without it. Providing a token only
# raises GitHub's public API rate limits; private repositories remain rejected.
GITHUB_TOKEN=
